# BlackHole runs immediately with its durable local store. Add these values for
# password protection, OpenAI synthesis, and PostgreSQL/pgvector persistence.
# APP_PASSWORD=choose-a-long-private-password
# AUTH_SECRET=generate-a-random-secret-at-least-32-characters-long
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# DATABASE_URL=postgresql://blackhole:blackhole@localhost:5432/blackhole
DATABASE_SSL=false
# Optional local libraries (separate multiple paths with ; on Windows or : on macOS/Linux)
BLACKHOLE_SKILL_ROOTS=
BLACKHOLE_VAULT_ROOTS=
